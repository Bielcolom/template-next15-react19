# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────

# MongoDB connection string. Required.
# Format: mongodb://<user>:<password>@<host>:<port>/<database>
MONGODB_URI=mongodb://127.0.0.1:27017/Boilerplate

# ─────────────────────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────────────────────

# Secret used to sign JWT session tokens. Required.
# Must be at least 32 characters long. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# ─────────────────────────────────────────────────────────────
# Redis (optional — authentication still works without it,
# but permission lookups will hit the database on every request)
# ─────────────────────────────────────────────────────────────

# Redis connection URL.
# Format: redis://<user>:<password>@<host>:<port>
# REDIS_URL=redis://127.0.0.1:6379

# How long (in seconds) to cache user permissions in Redis.
# Default: 300 (5 minutes)
# REDIS_PERMISSIONS_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────
# Seed script
# (used by scripts/seed.mjs — not required at runtime)
# ─────────────────────────────────────────────────────────────

# Passwords assigned to seeded users. Change before seeding production.
SEED_USER_PASSWORD=ChangeMe123!
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# Set to true to update passwords of existing seeded users on re-run.
SEED_UPDATE_PASSWORDS=false

# ─────────────────────────────────────────────────────────────
# Email (Resend — https://resend.com)
# ─────────────────────────────────────────────────────────────

# Resend API key. Required to send invitation emails.
# Get yours at: https://resend.com/api-keys
# RESEND_API_KEY=re_...

# Sender address shown in outgoing emails.
# Must be from a domain verified in your Resend account.
# Default falls back to Resend's sandbox address (onboarding@resend.dev).
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────

# Public base URL used to build invitation links in emails.
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Brand name shown in emails and UI.
# NEXT_PUBLIC_BRAND_NAME=Wozzo